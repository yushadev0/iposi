# Iposi backend configuration

# HTTP port the Express server listens on (nginx proxies /iposi/api/ here)
PORT=3001
NODE_ENV=production

# --- MSSQL (existing "iposi" database) ---
DB_SERVER=your-sql-host
# Named instance (leave DB_PORT empty when using this, needs SQL Browser / UDP 1434)
DB_INSTANCE=SQLEXPRESS
# ...or a static TCP port instead of the instance name
DB_PORT=
DB_USER=your_db_user
DB_PASSWORD=change_me
DB_NAME=iposi
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# --- Auth ---
# Long random string. Sessions/JWTs are signed with this.
SESSION_SECRET=change_me_to_a_long_random_string
# Send cookies only over HTTPS (set false for local http dev)
COOKIE_SECURE=true
# SameSite policy for auth cookies
COOKIE_SAMESITE=lax

# --- CORS ---
# Comma separated list of allowed browser origins in production
CORS_ORIGIN=https://your-domain.example

# --- Outbound proxy ---
# Timeout (ms) for the server-side HTTP requests Iposi fires on your behalf
PROXY_TIMEOUT_MS=15000
# Max response body size buffered from a proxied request (bytes)
PROXY_MAX_BYTES=10485760
